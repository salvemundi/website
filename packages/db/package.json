{
  "name": "@salvemundi/db",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "development": "./src/schema.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./relations": {
      "types": "./src/relations.ts",
      "development": "./src/relations.ts",
      "import": "./dist/relations.js",
      "default": "./dist/relations.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/index.ts src/schema.ts src/relations.ts --bundle --format=esm --platform=node --target=node22 --outdir=dist --sourcemap --packages=external",
    "type-check": "bun check",
    "generate": "drizzle-kit generate",
    "pull": "drizzle-kit pull",
    "dev:init": "node dev/init-local-db.mjs",
    "dev:seed": "node dev/seed-local-db.mjs"
  },
  "dependencies": {
    "postgres": "^3.4.4"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}