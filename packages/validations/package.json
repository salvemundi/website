{
    "name": "@salvemundi/validations",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "development": "./src/index.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./schema/*": {
            "types": "./src/schema/*.ts",
            "development": "./src/schema/*.ts",
            "import": "./dist/schema/*.js",
            "default": "./dist/schema/*.js"
        },
        "./security": {
            "types": "./src/security.ts",
            "development": "./src/security.ts",
            "import": "./dist/security.js",
            "default": "./dist/security.js"
        }
    },
    "scripts": {
        "build": "node build.mjs",
        "type-check": "bun check",
        "lint": "eslint src"
    },
    "dependencies": {
        "@salvemundi/db": "workspace:*",
        "drizzle-zod": "^0.8.3",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "drizzle-orm": "0.45.2"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "drizzle-orm": "catalog:",
        "esbuild": "catalog:",
        "eslint": "catalog:",
        "typescript": "catalog:"
    }
}