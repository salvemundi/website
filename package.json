{
  "name": "salve-mundi-v7",
  "version": "4.0.4",
  "private": true,
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "workspaces": {
    "packages": [
      "apps/frontend",
      "apps/services/*",
      "packages/*"
    ],
    "catalog": {
      "@azure/identity": "^4.13.1",
      "@directus/sdk": "^22.0.0",
      "@microsoft/microsoft-graph-client": "^3.0.7",
      "@types/node": "^26.0.0",
      "@types/qrcode": "^1.5.6",
      "drizzle-orm": "0.45.2",
      "eslint": "^9.39.5",
      "fastify": "5.12.6",
      "fastify-plugin": "^6.0.0",
      "ioredis": "^5.11.1",
      "knip": "^6.45.1",
      "qrcode": "^1.5.4",
      "typescript": "6.0.3",
      "zod": "^4.6.6"
    }
  },
  "scripts": {
    "dev": "bun run --filter @salvemundi/frontend dev",
    "dev:services": "bun run --parallel --if-present --filter './apps/services/*' dev",
    "dev:infra": "docker compose -f infrastructure/dev/docker-compose.yml up -d --wait",
    "dev:infra:down": "docker compose -f infrastructure/dev/docker-compose.yml down",
    "dev:db:init": "bun run --filter @salvemundi/db dev:init",
    "dev:db:seed": "bun run --filter @salvemundi/db dev:seed",
    "build": "bun run --filter '*' build",
    "lint": "bun run --parallel --if-present --filter '*' lint",
    "knip": "knip",
    "type-check": "bun run --if-present --filter '*' type-check",
    "validate": "bun run type-check && bun run lint && bun run knip && bun run build",
    "setup": "bun install && bun run validate",
    "db:sync": "bun run --filter @salvemundi/db pull && node packages/db/scripts/normalize-schema.mjs && bun run --filter @salvemundi/validations generate:zod"
  },
  "trustedDependencies": [
    "sharp"
  ],
  "overrides": {
    "sharp": "0.35.5",
    "@img/sharp-win32-x64": "0.35.5",
    "@img/sharp-linuxmusl-x64": "0.35.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "better-auth": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/cli": "1.4.21",
    "@better-auth/utils": "0.4.0",
    "@better-auth/telemetry": "1.7.7",
    "next": "16.4.6",
    "fast-uri": "^3.1.9",
    "esbuild": "^0.28.1",
    "axios": "1.15.0",
    "handlebars": "4.7.10",
    "fastify": "5.12.6",
    "defu": "6.1.5",
    "lodash": "4.18.1",
    "flatted": "3.4.2",
    "picomatch": "4.0.4",
    "kysely": "0.28.17",
    "postcss": "8.5.23",
    "protocol-buffers-schema": "3.6.1",
    "uuid@<11.1.1": "^11.1.1",
    "source-map": "^0.7.4",
    "browserslist": "^4.28.7",
    "find-my-way": "^9.7.0",
    "nanoid@<3.3.18": "^3.3.18",
    "deepmerge-ts": "^8.0.0",
    "@fastify/busboy": "^3.2.2",
    "source-map-js": "^1.2.2",
    "@azure/msal-node": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "catalog:",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0"
  }
}
