# Environment Configuratie voor Salve Mundi V7
# Kopieer dit bestand naar .env voor lokale ontwikkeling

# IP to bind internal service ports to (127.0.0.1 for local safety, or your VPN IP for remote staging/production)
VPN_IP=127.0.0.1

# --- Database & CMS ---
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
DB_PORT=your_db_port_here
DB_HOST=your_db_host_here

# Directus Security (Genereer met: openssl rand -base64 32)
DIRECTUS_KEY=your_directus_key_here
DIRECTUS_SECRET=your_directus_secret_here
AUTH_SAFE_REDIRECT_HOSTS=your_allowed_domain_here
DIRECTUS_STATIC_TOKEN=your_static_token_here

# --- Azure Core & Auth ---
AZURE_WEBSITEV7_TENANT_ID=your_tenant_id_here

# WebsiteV7-Auth (Frontend Login)
AZURE_WEBSITEV7_AUTH_CLIENT_ID=your_auth_client_id_here
AZURE_WEBSITEV7_AUTH_CLIENT_SECRET=your_auth_client_secret_here

# WebsiteV7-Sync (Background Processing)
AZURE_WEBSITEV7_SYNC_CLIENT_ID=your_sync_client_id_here
AZURE_WEBSITEV7_SYNC_CLIENT_SECRET=your_sync_client_secret_here

# WebsiteV7-Provisioning (User CRUD)
AZURE_WEBSITEV7_PROVISIONING_CLIENT_ID=your_provisioning_client_id_here
AZURE_WEBSITEV7_PROVISIONING_CLIENT_SECRET=your_provisioning_client_secret_here

# WebsiteV7-Mail (Transactional Emails)
AZURE_WEBSITEV7_MAIL_CLIENT_ID=your_mail_client_id_here
AZURE_WEBSITEV7_MAIL_CLIENT_SECRET=your_mail_client_secret_here

# WebsiteV7-NetBird-VPN (Developer Access)
AZURE_WEBSITEV7_NETBIRD_VPN_CLIENT_ID=your_netbird_client_id_here
AZURE_WEBSITEV7_NETBIRD_VPN_CLIENT_SECRET=your_netbird_client_secret_here

# --- Application Configuration ---
PUBLIC_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Shared Secret for Microservice Communication
INTERNAL_SERVICE_TOKEN=your_internal_service_token_here

# Primary Payment Provider
MOLLIE_API_KEY=your_mollie_api_key_here
MOLLIE_WEBHOOK_SECRET=your_mollie_webhook_secret_here

# --- Internal Service URLs (Docker DNS or Netbird IPs) ---
DIRECTUS_SERVICE_URL=http://your_directus_url_here
INTERNAL_FINANCE_URL=http://your_finance_url_here
INTERNAL_SYNC_URL=http://sync-service:3002
INTERNAL_MAIL_URL=http://mail-service:3003
REDIS_URL=redis://default:password@host:6379
NEXT_APP_INTERNAL_URL=http://localhost:3000

# --- Monitoring Service (Uptime Kuma & Discord Webhook) ---
MONITORING_PORT=port_number_here
KUMA_URL=http://your_kuma_url_here
KUMA_ADMIN_USER=your_kuma_admin_user_here
KUMA_ADMIN_PASSWORD=your_kuma_admin_password_here
DISCORD_MONITORING_WEBHOOK_URL=your_discord_webhook_url_here

# Target URLs monitored by Uptime Kuma
FRONTEND_SERVICE_URL=http://your_frontend_url_here
FINANCE_SERVICE_URL=http://your_finance_url_here
AZURE_SYNC_SERVICE_URL=http://your_sync_url_here
MAIL_SERVICE_URL=http://your_mail_url_here
AZURE_MANAGEMENT_SERVICE_URL=http://your_management_url_here
REDIS_HOST=your_redis_host_here
REDIS_PORT=your_redis_port_here
# --- Kroegentocht Google Sheet sync ---
# Sheet-ID stel je per kroegentocht in via het event-formulier.
# Deel elke sheet met GOOGLE_SERVICE_ACCOUNT_EMAIL (rol: Bewerker)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=replace_with_secret_manager_value
# ---------------------------------------------------------------------------
# Native iPhone app (acceptance only). See apps/mobile/README.md and apps/mobile/docs/.
# All gates default to off. Production never enables these.
# ---------------------------------------------------------------------------
# -- Mobile API (read by apps/frontend: proxy.ts, server/mobile/policy.ts) --
# Leave disabled until the mobile PR is validated; only honoured when ENV_NAME=acc.
MOBILE_API_ENABLED=false
# Apple organization Team ID for the acceptance app-link association route.
MOBILE_APPLE_TEAM_ID=
# -- Notification worker (apps/services/mobile-notification-service) --
# Configured independently; see apps/mobile/docs/mobile-acceptance.md.
MOBILE_NOTIFICATIONS_ENABLED=false
MOBILE_NOTIFICATION_ALLOWED_USER_IDS=
# Also read by the frontend device registration route.
MOBILE_APNS_ALLOW_PRODUCTION=false
# -- APNs credentials (worker only; never commit real values) --
APNS_TOPIC=nl.salvemundi.ios
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
# -- Optional worker safeguards, read by the worker/readiness code. Normally set by
#    apps/mobile/deployment/setup.py, so intentionally left commented out. --
# MOBILE_ACCEPTANCE_DB_ISOLATION_CONFIRMED=
# MOBILE_NOTIFICATION_SHARED_DB_PILOT=
# MOBILE_NOTIFICATION_SHARED_DB_USER_ID=
# MOBILE_NOTIFICATION_SHARED_DB_EXPECTED_NAME=
