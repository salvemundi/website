# Lokale ontwikkeling: kopieer naar .env.local. De waarden hieronder passen bij infrastructure/dev/docker-compose.yml.

PUBLIC_URL=http://localhost:3000
NEXT_APP_INTERNAL_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me
INTERNAL_SERVICE_TOKEN=local-dev-internal-token

# Microsoft-login werkt lokaal pas met echte Entra-gegevens; de site start ook met deze placeholders.
AZURE_WEBSITEV7_TENANT_ID=common
AZURE_WEBSITEV7_AUTH_CLIENT_ID=local-dev
AZURE_WEBSITEV7_AUTH_CLIENT_SECRET=local-dev

DB_USER=salvemundi
DB_PASSWORD=salvemundi
DB_NAME=salvemundi
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_URL=redis://default:salvemundi@127.0.0.1:6379

INTERNAL_DIRECTUS_URL=http://127.0.0.1:8055
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
DIRECTUS_STATIC_TOKEN=local-dev-directus-token

# Optionele microservices (apps/services/*); zonder deze werken alleen de bijbehorende functies niet.
# FINANCE_SERVICE_URL=http://localhost:3001
# AZURE_SYNC_SERVICE_URL=http://localhost:3002
# MAIL_SERVICE_URL=http://localhost:3003
# AZURE_MANAGEMENT_SERVICE_URL=http://localhost:3004
