{
  "name": "@salvemundi/frontend",
  "version": "4.2.0",
  "private": true,
  "scripts": {
    "sync:maplibre-worker": "node -e \"const fs=require('fs'),p='public/map/worker';fs.mkdirSync(p,{recursive:true});for(const f of ['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'])fs.copyFileSync('node_modules/maplibre-gl/dist/'+f,p+'/'+f);\"",
    "predev": "bun run sync:maplibre-worker",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev --turbo",
    "prebuild": "bun run sync:maplibre-worker",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "next start",
    "lint": "eslint src",
    "check-lint": "eslint src",
    "type-check": "bun check",
    "knip": "knip",
    "validate": "bun run type-check && bun run lint && bun run knip && bun run build",
    "audit:security": "bun audit",
    "audit:duplication": "jscpd src",
    "audit:unused": "knip"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mantine/core": "^9.8.1",
    "@mantine/dates": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@salvemundi/db": "workspace:*",
    "@salvemundi/validations": "workspace:*",
    "better-auth": "1.7.7",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "catalog:",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "ioredis": "catalog:",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "6.4.1",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "qrcode": "catalog:",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "signature_pad": "^5.1.4",
    "tailwind-merge": "^3.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "^1.61.1",
    "@serwist/next": "^9.5.15",
    "@serwist/precaching": "^9.5.15",
    "@serwist/sw": "^9.5.15",
    "@serwist/webpack-plugin": "^9.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "cross-env": "^10.1.0",
    "eslint": "catalog:",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jscpd": "^5.0.12",
    "knip": "catalog:",
    "postcss": "8.5.23",
    "serwist": "^9.5.15",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:"
