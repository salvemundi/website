{{#> layout headerTitle="NIEUWE CAMERA-AANVRAAG"}}
    <div class="status-badge warning">Actie vereist</div>
    <p>Hoi,</p>

    <p><strong>{{requesterName}}</strong> heeft de verenigingscamera aangevraagd. Beoordeel de aanvraag in het beheerpaneel.</p>

    <p><strong>Activiteit:</strong> {{eventName}}<br>
    <strong>Periode:</strong> {{period}}{{#if photographer}}<br>
    <strong>Gewenste fotograaf:</strong> {{photographer}}{{/if}}{{#if note}}<br>
    <strong>Opmerking:</strong> {{note}}{{/if}}</p>

    <p style="text-align: center;">
        <a href="{{url}}" class="button" style="display: inline-block; padding: 18px 36px; background-color: #a4539b; color: #ffffff !important; text-decoration: none; border-radius: 14px; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; margin: 25px 0; mso-padding-alt: 0;">Aanvraag beoordelen</a>
    </p>

    <p style="margin-top: 30px;">Met vriendelijke groet,<br><br>
    <strong>Salve Mundi</strong><br>
    Rachelsmolen 1<br>
    5612 MA Eindhoven</p>
{{/layout}}
