{{#> layout headerTitle="NDA'S VERSTUURD"}}
    <div class="status-badge info">Ter info</div>
    <p>Beste secretaris,</p>

    <p>Er {{#if (eq recipientCount 1)}}is{{else}}zijn{{/if}} zojuist <strong>{{recipientCount}}</strong> NDA-uitnodiging{{#unless (eq recipientCount 1)}}en{{/unless}} verstuurd voor de <strong>{{committeeName}}</strong>:</p>

    <div class="details">
        {{#each recipients}}
        <p>{{this.name}} &mdash; {{this.email}}</p>
        {{/each}}
    </div>

    <p style="text-align: center;">
        <a href="{{adminUrl}}" class="button" style="display: inline-block; padding: 18px 36px; background-color: #a4539b; color: #ffffff !important; text-decoration: none; border-radius: 14px; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; margin: 25px 0; mso-padding-alt: 0;">Status Bekijken</a>
    </p>

    <p style="margin-top: 30px;">Met vriendelijke groet,<br><br>
    <strong>Salve Mundi</strong><br>
    Rachelsmolen 1<br>
    5612 MA Eindhoven</p>
{{/layout}}
