{
  "name": "@salvemundi/mail-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.cpSync('src/templates', 'dist/templates', {recursive: true}); fs.cpSync('src/assets', 'dist/assets', {recursive: true})\"",
    "type-check": "bun check",
    "lint": "eslint src"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@fastify/rate-limit": "^11.0.0",
    "@salvemundi/db": "workspace:*",
    "@salvemundi/validations": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.6",
    "fastify-plugin": "^6.0.0",
    "handlebars": "4.7.10",
    "ioredis": "^5.11.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "6.0.3"
  }
}
