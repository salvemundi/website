{
  "name": "@salvemundi/mail-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=development watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.cpSync('src/templates', 'dist/templates', {recursive: true}); fs.cpSync('src/assets', 'dist/assets', {recursive: true})\"",
    "type-check": "node ../../../node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@azure/identity": "catalog:",
    "@fastify/rate-limit": "^11.0.0",
    "@salvemundi/db": "workspace:*",
    "@salvemundi/validations": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "handlebars": "4.7.10",
    "ioredis": "catalog:",
    "qrcode": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
